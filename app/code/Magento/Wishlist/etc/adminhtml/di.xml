<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Wishlist\Model\Wishlist">
        <arguments>
            <argument name="useCurrentWebsite" xsi:type="boolean">false</argument>
        </arguments>
    </type>
    <virtualType name="Magento\Wishlist\Model\Session\Storage" type="Magento\Framework\Session\Storage">
        <arguments>
            <argument name="namespace" xsi:type="string">wishlist</argument>
        </arguments>
    </virtualType>
    <virtualType name="Magento\Wishlist\Model\Session" type="Magento\Framework\Session\Generic">
        <arguments>
            <argument name="storage" xsi:type="object">Magento\Wishlist\Model\Session\Storage</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Catalog\Model\ResourceModel\Product">
        <plugin name="cleanups_wishlist_item_after_product_delete" type="Magento\Wishlist\Plugin\Model\ResourceModel\Product" />
    </type>
    <preference for="Magento\Wishlist\Model\ResourceModel\Item\Product\CollectionBuilderInterface"
                type="Magento\Wishlist\Model\Adminhtml\ResourceModel\Item\Product\CollectionBuilder"/>
    <type name="Magento\Sales\Block\Adminhtml\Order\Create\Items\Grid">
        <arguments>
            <!-- Overrides the null configured by Magento_Sales. Argument configuration is
                 inherited, so subclasses that typehint WishlistFactory receive the factory.
                 The block itself has an untyped parameter, which DI passes this configuration
                 to uninstantiated; the block instantiates it, see resolveWishlistFactory(). -->
            <argument name="wishlistFactory" xsi:type="object">Magento\Wishlist\Model\WishlistFactory</argument>
        </arguments>
    </type>
    <!-- These classes moved here from Magento_Customer. Create them under their old names, so preferences
         and plugins that other code declares for the old names keep applying. Remove with the old names. -->
    <preference for="Magento\Wishlist\Block\Adminhtml\Customer\Edit\Tab\View\Wishlist"
                type="Magento\Customer\Block\Adminhtml\Edit\Tab\View\Wishlist"/>
    <preference for="Magento\Wishlist\Controller\Adminhtml\Index\Wishlist"
                type="Magento\Customer\Controller\Adminhtml\Index\Wishlist"/>
    <preference for="Magento\Wishlist\Controller\Adminhtml\Index\ViewWishlist"
                type="Magento\Customer\Controller\Adminhtml\Index\ViewWishlist"/>
    <preference for="Magento\Wishlist\Controller\Adminhtml\Wishlist\Product\Composite\Wishlist\Configure"
                type="Magento\Customer\Controller\Adminhtml\Wishlist\Product\Composite\Wishlist\Configure"/>
    <preference for="Magento\Wishlist\Controller\Adminhtml\Wishlist\Product\Composite\Wishlist\Update"
                type="Magento\Customer\Controller\Adminhtml\Wishlist\Product\Composite\Wishlist\Update"/>
</config>
